{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.4.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "API",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 } }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rate(http_requests_total[1m])",
          "legendFormat": "{{method}} {{path}}",
          "refId": "A"
        }
      ],
      "title": "API Request Rate (req/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 }, "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "P99 {{path}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "P50 {{path}}",
          "refId": "B"
        }
      ],
      "title": "API Latency (P50 / P99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 } }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "targets": [
        {
          "expr": "rate(http_requests_total{status=~\"5..\"}[1m])",
          "legendFormat": "5xx {{path}}",
          "refId": "A"
        }
      ],
      "title": "API Error Rate (5xx/s)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "NER Pipeline",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 } }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 4,
      "targets": [
        {
          "expr": "rate(ner_articles_processed_total[5m])",
          "legendFormat": "Articles/s",
          "refId": "A"
        }
      ],
      "title": "NER Throughput (articles/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 } }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 5,
      "targets": [
        {
          "expr": "rate(ner_entities_extracted_total[5m])",
          "legendFormat": "{{entity_type}}",
          "refId": "A"
        }
      ],
      "title": "Entity Extraction Rate by Type (entities/s)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "Jobs",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 6,
      "options": { "bucketOffset": 0, "fillOpacity": 80 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (job_name, le) (rate(job_duration_seconds_bucket[10m])))",
          "legendFormat": "{{job_name}}",
          "refId": "A"
        }
      ],
      "title": "Job Duration P99 (s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 7,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "expr": "increase(job_runs_total[24h])",
          "legendFormat": "{{job_name}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "Job Runs (last 24h)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 103,
      "title": "Evaluation Metrics",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 0.7 },
            { "color": "green", "value": 0.85 }
          ]},
          "min": 0, "max": 1, "unit": "percentunit"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 28 },
      "id": 8,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [
        { "expr": "eval_f1{entity_type=\"PER\"}", "legendFormat": "PER", "refId": "A" },
        { "expr": "eval_f1{entity_type=\"ORG\"}", "legendFormat": "ORG", "refId": "B" },
        { "expr": "eval_f1{entity_type=\"LOC\"}", "legendFormat": "LOC", "refId": "C" },
        { "expr": "eval_f1{entity_type=\"MISC\"}", "legendFormat": "MISC", "refId": "D" }
      ],
      "title": "F1 per Entity Type",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 0.7 },
            { "color": "green", "value": 0.85 }
          ]},
          "min": 0, "max": 1, "unit": "percentunit"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 28 },
      "id": 9,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [
        { "expr": "eval_f1{entity_type=\"overall\"}", "legendFormat": "Overall F1", "refId": "A" },
        { "expr": "eval_precision{entity_type=\"overall\"}", "legendFormat": "Overall Precision", "refId": "B" },
        { "expr": "eval_recall{entity_type=\"overall\"}", "legendFormat": "Overall Recall", "refId": "C" }
      ],
      "title": "Overall NER Scores",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 }, "min": 0, "max": 1 }
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 28 },
      "id": 10,
      "targets": [
        { "expr": "eval_precision{entity_type=\"overall\"}", "legendFormat": "Precision", "refId": "A" },
        { "expr": "eval_recall{entity_type=\"overall\"}", "legendFormat": "Recall", "refId": "B" },
        { "expr": "eval_f1{entity_type=\"overall\"}", "legendFormat": "F1", "refId": "C" }
      ],
      "title": "Eval Precision / Recall / F1 Over Time",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {} },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 34 },
      "id": 11,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "value" },
      "targets": [
        {
          "expr": "eval_last_run_timestamp",
          "legendFormat": "Last Eval Run",
          "refId": "A"
        }
      ],
      "title": "Last Evaluation Timestamp",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 38 },
      "id": 104,
      "title": "MongoDB",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 39 },
      "id": 12,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "expr": "mongo_collection_size",
          "legendFormat": "{{database}}.{{collection}}",
          "refId": "A"
        }
      ],
      "title": "MongoDB Collection Sizes",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["nlp", "pipeline"],
  "templating": { "list": [] },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "NLP Pipeline",
  "uid": "nlp-pipeline-v1",
  "version": 1
}
