# ── Environment ──────────────────────────────────────────────────────────────
# Runtime environment (development, staging, production)
ENVIRONMENT=development

# ── MongoDB ─────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017
# With auth: mongodb://user:pass@mongodb:27017
# Atlas:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017

# MongoDB auth credentials (used in docker-compose.prod.yml)
# Leave empty to disable auth
MONGO_USERNAME=
MONGO_PASSWORD=

# Database names
RAW_DB_NAME=nlp_raw
CLEAN_DB_NAME=nlp_clean
CLASSIFIED_DB_NAME=nlp_classified
MODELS_DB_NAME=nlp_models
NER_DB_NAME=nlp_ner

# Collection names
RAW_COLLECTION=articles
CLEAN_COLLECTION=articles
CLASSIFIED_COLLECTION=articles
NER_COLLECTION=ner_articles

# ── Scheduler ────────────────────────────────────────────────────────────────
# UTC hour to run the daily scrape job (0 = midnight)
SCRAPE_HOUR=0

# Run cleaning pipeline automatically after scrape (true/false)
RUN_CLEAN_AFTER_SCRAPE=false

# Skip articles whose detected language is not English (true/false)
ENGLISH_ONLY=true

# ── Evaluation ───────────────────────────────────────────────────────────────
# Number of NER documents sampled for separability evaluation
EVAL_SEPARABILITY_SAMPLE=200

# ── Kaggle Dataset Bootstrap ─────────────────────────────────────────────────
# On container init, download and ingest Kaggle dataset if MongoDB is empty.
#
# 1. Set KAGGLE_ENABLED=true
# 2. Generate credentials at https://www.kaggle.com/settings/account
# 3. Download kaggle.json:
#    - Modern tokens: Leave KAGGLE_USERNAME empty, paste full token in KAGGLE_KEY
#    - Legacy format: Paste both username and key
# 4. Restart container
#
# Dataset: https://www.kaggle.com/datasets/julianschelb/newsdata

# Enable Kaggle dataset bootstrap (true/false)
KAGGLE_ENABLED=false

# Kaggle dataset identifier (owner/dataset-name)
KAGGLE_DATASET=julianschelb/newsdata

# Kaggle API credentials
KAGGLE_USERNAME=
KAGGLE_KEY=

# Local download path for Kaggle data (inside container)
KAGGLE_DOWNLOAD_PATH=/tmp/kaggle_datasets

# Skip bootstrap entirely (useful after initial setup)
SKIP_BOOTSTRAP=false

# Skip Rank-1 URL re-fetch during cleaning (useful for historical datasets)
SKIP_RANK1_RECOVERY=false

# ── Monitoring ───────────────────────────────────────────────────────────────
# Grafana admin password (used in docker-compose.prod.yml)
GRAFANA_ADMIN_PASSWORD=changeme

# ── Application Settings ─────────────────────────────────────────────────────
# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Python output buffering (1 = immediate, 0 = buffered)
PYTHONUNBUFFERED=1

# ── Performance Tuning ───────────────────────────────────────────────────────
# Thread counts for numerical libraries
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
